<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/alertRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_alert_gradient">

    <View
        android:layout_width="320dp"
        android:layout_height="320dp"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="-80dp"
        android:background="@drawable/bg_alert_glow" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/alertScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="26dp"
            android:paddingTop="54dp"
            android:paddingEnd="26dp"
            android:paddingBottom="30dp">

            <FrameLayout
                android:id="@+id/alertIconContainer"
                android:layout_width="94dp"
                android:layout_height="94dp"
                android:background="@drawable/bg_alert_icon">

                <ImageView
                    android:id="@+id/alertCarIcon"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_car"
                    app:tint="@color/alertAccent" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:letterSpacing="0.1"
                android:text="@string/alert_title"
                android:textColor="@color/alertAccent"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/alertHeadline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="@string/alert_headline"
                android:textColor="@color/alertText"
                android:textSize="30sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/alertTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/alertMuted"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/alertKeywords"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_alert_keyword"
                android:paddingStart="11dp"
                android:paddingTop="5dp"
                android:paddingEnd="11dp"
                android:paddingBottom="5dp"
                android:textColor="@color/alertAccent"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/alertSender"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center"
                android:textColor="@color/alertMuted"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_alert_message"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.08"
                    android:text="@string/body_label"
                    android:textColor="@color/alertAccent"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/alertBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:lineSpacingExtra="3dp"
                    android:textColor="@color/alertText"
                    android:textIsSelectable="true"
                    android:textSize="16sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/alertCountdown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center"
                android:textColor="@color/alertMuted"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/ackButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="14dp"
                android:backgroundTint="@color/alertAccent"
                android:text="@string/ack"
                android:textColor="@color/alertButtonText"
                android:textSize="17sp"
                android:textStyle="bold"
                app:cornerRadius="18dp"
                app:icon="@drawable/ic_check"
                app:iconGravity="textStart"
                app:iconTint="@color/alertButtonText" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/snoozeButton"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="10dp"
                android:text="@string/snooze"
                android:textColor="@color/alertText"
                android:textSize="15sp"
                app:cornerRadius="18dp"
                app:icon="@drawable/ic_schedule"
                app:iconGravity="textStart"
                app:iconTint="@color/alertText"
                app:strokeColor="@color/alertMuted"
                app:strokeWidth="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/silenceButton"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginTop="2dp"
                android:text="@string/silence"
                android:textColor="@color/alertMuted"
                android:textSize="13sp" />

            <TextView
                style="@style/TextAppearance.ParkingAlert.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:text="@string/alert_footer_hint"
                android:textColor="@color/alertMuted" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</FrameLayout>
